<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 min-h-screen antialiased font-sans text-gray-900">

    <header class="w-full bg-white/80 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50">
        <div class="max-w-2xl mx-auto px-4 h-16 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <!-- upload profile picture -->
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 shadow-sm flex items-center justify-center text-white font-bold text-sm uppercase ring-2 ring-white">
                    <% if (user.profilepic) { %>
                        <img src="/images/uploads/<%= user.profilepic %>" alt="Profile" class="w-full h-full rounded-full object-cover">
                        <% } else { %>
                            <%= user.name ? user.name.charAt(0) : '?' %>
                            <% } %>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 tracking-tight">Hi, <%= user.name %> 👋</h3>
                    <h5 class="text-[11px] text-slate-400 font-medium">You can create a post</h5>
                </div>
            </div>
            <a href="/logout" class="text-xs font-semibold text-rose-600 hover:text-white transition-all duration-200 bg-rose-50/50 hover:bg-rose-600 px-3.5 py-2 rounded-xl border border-rose-100 hover:border-rose-600 flex items-center gap-1.5 shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
                </svg>
                Logout
            </a>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-8 space-y-8">
        
        <section class="bg-white p-5 rounded-2xl border border-gray-200/70 shadow-xs">
            <form class="space-y-3" action="/post" method="POST">
                <textarea name="postData" placeholder="What's on your mind?" class="w-full h-24 p-3.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-sm transition-all resize-none placeholder-gray-400 bg-gray-50/30 focus:bg-white"></textarea>
                <div class="flex justify-end">
                    <input type="submit" value="Post" class="px-6 bg-blue-600 text-white text-sm font-semibold py-2 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition duration-200 cursor-pointer shadow-xs shadow-blue-500/10">
                </div>
            </form>
        </section>
        
        <section class="space-y-4">
            <% if (user.posts.length > 0) { %>
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider px-1">Your Posts</h3>
            
            <div class="postcontainer space-y-4">
                <% post.reverse().forEach(function(post) { %>
                    <div class="post p-5 bg-white rounded-2xl border border-gray-200/70 shadow-xs space-y-3">
                     <h4 class="text-sm font-semibold text-gray-900">@<%= user.username %></h4>
                    <p class="text-sm text-gray-600 leading-relaxed"><%= post.postData %></p>
                    <small class="text-xs text-gray-400"><%= post.likes.length %> likes</small>
                    <div class="flex items-center gap-4 pt-2 text-xs font-medium border-t border-gray-100">
                        <a href="/like/<%= post._id %>" class="text-blue-600 hover:text-blue-700 flex items-center gap-1 transition-colors">
                            <%= post.likes.indexOf(user._id) == -1 ? 'Like' : 'Unlike' %>
                        </a>
                        <span class="text-gray-300">•</span>
                        <a href="/edit/<%= post._id %>" class="text-gray-500 hover:text-gray-700 transition-colors">
                            Edit
                        </a>
                    </div>
                </div>
                <% }) %>
            </div>
             <% } else { %>
            <p class="text-gray-500 text-sm">You haven't created any posts yet.</p>
             <% } %>
        </section>

    </main>

</body>
</html>