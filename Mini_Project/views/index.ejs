<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 flex min-h-screen items-center justify-center p-4 antialiased font-sans">
    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
        <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">Create Account</h3>
        <form action="/register" method="POST" autocomplete="off" class="flex flex-col gap-4">
            <input type="text" placeholder="Enter username" name="username" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
            <input type="text" placeholder="Enter your name" name="name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
            <input type="number" placeholder="Enter your age" name="age" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
            <input type="email" placeholder="Enter your email" name="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
            
            <input type="password" placeholder="Enter your password" name="password" autocomplete="new-password" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
            
            <input type="submit" value="Create Account" class="w-full mt-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg cursor-pointer transition-colors duration-200 shadow-sm" />
            <hr>
            <p class="text-sm text-gray-600 text-center">Already have an account? <a href="/login" class="text-blue-600 hover:text-blue-700 font-semibold">Login</a></p>
        </form>
    </div>
</body>
</html>