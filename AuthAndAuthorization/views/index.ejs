<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="flex justify-center items-center h-screen bg-gray-100">
    <form action="/create" method="POST" class="bg-white p-6 rounded-lg shadow-md flex flex-col gap-4 w-80">
    <h2 class="text-xl font-bold text-gray-700 mb-2">Create Account</h2>
    
    <input type="text" name="fake_username" style="display:none;" aria-hidden="true">
    <input type="password" name="fake_password" style="display:none;" aria-hidden="true">

    <input type="text" name="username" placeholder="Username" autocomplete="off"
        class="border border-gray-300 p-2 rounded focus:outline-blue-500">
        
    <input type="password" name="password" placeholder="Password" autocomplete="new-password"
        class="border border-gray-300 p-2 rounded focus:outline-blue-500">
        
    <input type="email" name="email" placeholder="Email" autocomplete="off"
        class="border border-gray-300 p-2 rounded focus:outline-blue-500">
        
    <input type="number" name="age" placeholder="Age"
        class="border border-gray-300 p-2 rounded focus:outline-blue-500">
        
    <input type="submit" value="Submit" 
        class="bg-blue-500 text-white p-2 rounded font-semibold cursor-pointer hover:bg-blue-600 transition">
</form>
</div>
</body>
</html>